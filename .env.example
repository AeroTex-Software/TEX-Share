# TEX Share configuration. Copy to `.env` and adjust.
# Only bootstrap/secret values live here; everything else is configured from
# the admin UI and stored in the database.

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------
# Where the SQLite database, uploaded files, backups and keys are stored.
TEXSHARE_DATA_DIR=/data

# Bind addresses inside the container. Both ports are published by default.
TEXSHARE_PUBLIC_ADDR=0.0.0.0:3535
TEXSHARE_ADMIN_ADDR=0.0.0.0:3636

# Canonical public/admin URLs. Set these to the addresses users actually type
# (used for CSRF origin checks and generated share links), e.g.
#   TEXSHARE_PUBLIC_URL=https://share.example.com
#   TEXSHARE_ADMIN_URL=https://admin.example.com
TEXSHARE_PUBLIC_URL=
TEXSHARE_ADMIN_URL=

# Extra hostnames accepted by the public and admin listeners (comma separated).
# Domains added through the admin UI are accepted automatically.
TEXSHARE_ALLOWED_HOSTS=
TEXSHARE_ADMIN_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# Reverse proxy / TLS
# ---------------------------------------------------------------------------
# Trust X-Forwarded-For / CF-Connecting-IP. Enable ONLY behind a trusted proxy,
# otherwise clients can spoof their address and bypass rate limiting.
TEXSHARE_TRUST_PROXY=false

# Mark cookies Secure even when the request arrives over plain HTTP (e.g. TLS
# terminated upstream). Recommended when serving HTTPS through a proxy.
TEXSHARE_FORCE_SECURE_COOKIES=false

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# debug | info | warn | error
TEXSHARE_LOG_LEVEL=info
TEXSHARE_ACCESS_LOG=true

# ---------------------------------------------------------------------------
# Antivirus (ClamAV)
# ---------------------------------------------------------------------------
# Enable scanning. The bundled image contains clamd/freshclam for "managed"
# mode; use "external" to talk to an existing clamdscan.
TEXSHARE_CLAMAV_ENABLED=false
# managed | external
TEXSHARE_CLAMAV_MODE=managed
TEXSHARE_CLAMD_PATH=clamd
TEXSHARE_FRESHCLAM_PATH=freshclam
TEXSHARE_CLAMDSCAN_PATH=clamdscan

# ---------------------------------------------------------------------------
# Cloudflare Tunnel (optional)
# ---------------------------------------------------------------------------
TEXSHARE_CLOUDFLARE_ENABLED=false
TEXSHARE_CLOUDFLARED_PATH=cloudflared

# ---------------------------------------------------------------------------
# Advanced
# ---------------------------------------------------------------------------
# Path to the key used to encrypt automatic backups. Defaults to
# <data>/backup.key and is created automatically.
TEXSHARE_BACKUP_KEY_FILE=

# Development mode relaxes host validation and uses http:// share links.
# Never enable in production.
TEXSHARE_DEV=false

# Reported by the version endpoint; normally set by the build.
TEXSHARE_VERSION=1.0.0
TEXSHARE_COMMIT=dev
